@page "/prestacao"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using SiaeIntegracao.src.Domain.Dtos
@using System.Diagnostics
@using static System.Net.WebRequestMethods
@inject HttpClient Http
@inject IJSRuntime JS
@inject ProtectedLocalStorage ProtectedLocalStore
@inject NavigationManager NavigationManager

@if(isAuthorized)
{
    <div class="container-fluid">
        @if (exibirSucesso)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Sucesso!</strong> O lançamento foi registrado no banco de dados.
                <button type="button" class="btn-close" @onclick="() => exibirSucesso = false"></button>
            </div>
        }
        <h3 class="mb-4">Nova Prestação de Contas</h3>

        <div class="card mb-4 border-primary">
            <div class="card-body bg-light">
                <div class="row">
                    <div class="col-md-6">
                        <label class="fw-bold">Unidade / Projeto</label>
                        <select class="form-select"  @onchange="OnUnidadeChanged">
                            <option>Selecione a unidade...</option>

                            @foreach (var u in unidades)
                            {
                                // O usuário vê o Nome, mas o C# captura o IdeProjeto
                                <option value="@u.Projeto">@u.NomeFilial</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="fw-bold">Data</label>
                        @* Remova o @bind e use essa combinação: *@
                        <input type="date" class="form-control"
                               value="@dataSelecionada.ToString("yyyy-MM-dd")"
                               @onchange="OnDataChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">
                        Registrar Lançamento Prestação de Contas
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label>Tipo de Lançamento</label>
                                <select class="form-select" disabled="@isProcessado" @onchange="OnTipoChanged">
                                    <option>Selecione (ex: Rotativo, Convênio...)</option>
                                    @foreach (var t in tiposLancamento)
                                    {
                                        <option value="@t.IdeLancamento">@t.DescricaoLancamento</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>Quantidade</label>
                                <input type="number" class="form-control" placeholder="0" disabled="@isProcessado" @bind="quantidade" />
                            </div>
                            <div class="col-md-3">
                                <label>Valor</label>
                                <div class="input-group">
                                    <span class="input-group-text">R$</span>
                                    <input type="number" class="form-control" placeholder="0,00" disabled="@isProcessado" @bind="valor" />
                                </div>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-success w-100" disabled="@isProcessado" @onclick="GravarLancamento">
                                    <i class="oi oi-plus"></i> Gravar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4 shadow-sm p-3 bg-white rounded">
            <h5 class="mb-3"><i class="bi bi-list-check"></i> Lançamentos Realizados</h5>

            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Lançamento</th>
                        <th>Qtd</th>
                        <th>Valor Unit.</th>
                        <th>Status</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (lancamentosDoDia.Any())
                    {
                        @foreach (var item in lancamentosDoDia)
                        {
                            <tr>
                                <td>@item.IdeLancamento</td>
                                <td>@item.NomeLancamento</td>
                                <td>@item.Quantidade</td>
                                <td>@item.Valor?.ToString("C2")</td>
                                <td>@item.Status</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger" disabled="@isProcessado" title="Excluir" @onclick="() => DeletarLancamento(item.IdLancamento)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">Nenhum lançamento encontrado para esta data.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
} else
{
    <p>Verificando acesso...</p>
}


@code {

    private List<EntryTypeDto> tiposLancamento = new();
    private EntryTypeDto? tipoSelecionado;
    private int quantidade;
    private double valor;
    private DateTime dataSelecionada = DateTime.Today;
    private bool exibirSucesso = false;
    private List<CapaPcOnlineDto> lancamentosDoDia = new();
    // 1. Onde vamos guardar as unidades que vêm da API
    public List<FilialDto> unidades = new();
    public bool isAuthorized;
    bool isProcessado => lancamentosDoDia.Any(x => x.Status == "Processado");

    // 2. Variável para guardar qual unidade o usuário clicou
    private string unidadeSelecionada = "";

    // 3. O "Power On": Esse método roda assim que a tela abre
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userId = await ProtectedLocalStore.GetAsync<long>("user_id");

            if (userId.Success || userId.Value> 0)
            {               
                isAuthorized = true;
                StateHasChanged();
            }
            else
            {
                NavigationManager.NavigateTo("/");
            }
            Debug.WriteLine(">>> O CÓDIGO RODOU! TENTANDO BUSCAR DADOS..."); // Isso tem que aparecer no F12
            try
            {
                var retorno = await Http.GetFromJsonAsync<List<FilialDto>>("api/Units/allowed/1");
                if (retorno != null)
                {
                    unidades = retorno;
                    Debug.WriteLine($">>> CHEGARAM {unidades.Count} UNIDADES!");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Debug.WriteLine($">>> ERRO NA BUSCA: {ex.Message}");
            }
        }
    }


    // 2. A função que "ouve" a mudança da unidade
    private async Task OnUnidadeChanged(ChangeEventArgs e)
    {
        unidadeSelecionada = e.Value?.ToString() ?? "";

        if (!string.IsNullOrEmpty(unidadeSelecionada))
        {
            try
            {
                Debug.WriteLine(">>> O CÓDIGO RODOU! TENTANDO BUSCAR DADOS..."); // Isso tem que aparecer no F12
                // Substitua 'api/entries/project/SIAE' pela sua rota real de tipos
                var retorno = await Http.GetFromJsonAsync<List<EntryTypeDto>>($"api/EntryType/entryTypes/{unidadeSelecionada}");

                if (retorno != null)
                {
                    tiposLancamento = retorno;
                    Debug.WriteLine($">>> CHEGARAM {tiposLancamento.Count} TIPOS DE LANÇAMENTO PARA A UNIDADE {unidadeSelecionada}!");
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($">>> ERRO AO BUSCAR TIPOS: {ex.Message}");
            }
        }
    }
    private void OnTipoChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var id))
        {
            // Busca na lista o objeto completo que veio da API
            tipoSelecionado = tiposLancamento.FirstOrDefault(x => x.IdeLancamento == id);
        }
    }

    private async Task GravarLancamento()
    {
        // 1. Validação básica: se não selecionou o tipo, não prossegue
        if (tipoSelecionado == null) return;

        // 2. Montagem do objeto conforme seu DTO de Capa
        var novoLancamento = new CapaPcOnlineDto
        {
            IdeEmpresa = tipoSelecionado.IdeEmpresa,
            IdePojeto = tipoSelecionado.IdeProjeto, // Note o erro de digitação no seu DTO: IdePojeto
            IdeFilial = tipoSelecionado.IdeFilial,
            IdeClasse = long.Parse(tipoSelecionado.ClasseFinanceira),
            IdeLancamento = tipoSelecionado.IdeLancamento,
            NomeLancamento = tipoSelecionado.DescricaoLancamento,
            OrdemLancamento = tipoSelecionado.IdeOdemPosicionamento,

            // Dados que o Bruno digitou na tela:
            DataPc = DateOnly.FromDateTime(dataSelecionada),
            Quantidade = quantidade,
            Valor = valor,

            // Dados de auditoria e status:
            Modalidade = tipoSelecionado.ModalidadeLancamento,
            IdeDocumento = tipoSelecionado.CodigoDocumento,
            UsuarioCriou = "Bruno Guimarães", // Aqui depois pegamos o usuário logado
            DataCriacao = DateTime.Now,
            Status = "Digitando"
        };

        try
        {
            // 3. O comando POST para o seu Back-end gravar no banco
            var response = await Http.PostAsJsonAsync("api/CapaPc/createCapaPc", novoLancamento);

            if (response.IsSuccessStatusCode)
            {
                exibirSucesso = true;
                StateHasChanged();

                // Opcional: Esconder a mensagem após 3 segundos
                await Task.Delay(3000);
                exibirSucesso = false;
                // Aqui a gente pode limpar os campos para o próximo lançamento
                quantidade = 0;
                valor = 0;
                await CarregarLancamentos();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($">>> ERRO AO GRAVAR: {ex.Message}");
        }
    }
    private async Task CarregarLancamentos()
    {
        if (string.IsNullOrEmpty(unidadeSelecionada)) return;

        try
        {
            // 1. Limpa a lista atual para garantir que os dados "sumam" da tela enquanto busca
            lancamentosDoDia = new();
            StateHasChanged();

            var dataFormatada = dataSelecionada.ToString("yyyy-MM-dd");

            var url = $"api/CapaPc/getCapaPCByDate/{unidadeSelecionada}/date/{dataFormatada}";

            var retorno = await Http.GetFromJsonAsync<List<CapaPcOnlineDto>>(url);

            if (retorno != null)
            {
                lancamentosDoDia = retorno;
            }

        }
        catch (HttpRequestException ex)
        {
            // Se a API retornar 404 ou erro de rede, a lista continua vazia (correto!)
            Console.WriteLine($">>> API não retornou dados ou está offline: {ex.StatusCode}");
            lancamentosDoDia = new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($">>> ERRO GERAL: {ex.Message}");
            lancamentosDoDia = new();
        }
        finally
        {
            // 3. Garante que a tela atualize independente de ter dado erro ou não
            StateHasChanged();
        }
    }
    private async Task OnDataChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var novaData))
        {
            dataSelecionada = novaData;
            await CarregarLancamentos(); // Busca os dados da nova data selecionada

        }
    }
    private async Task DeletarLancamento(long id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este documento?");

        if (confirmado)
        {
            var response = await Http.DeleteAsync($"api/CapaPc/deleteCapaPcById/{id}");

            if (response.IsSuccessStatusCode)
            {
                // 2. Atualiza a lista na tela sem precisar dar F5
                lancamentosDoDia.RemoveAll(x => x.IdLancamento == id);
                StateHasChanged();
            }
            else
            {
                // Trata o erro se a API não retornar sucesso
                Console.WriteLine("Erro ao deletar o documento.");
            }
        }
    }
    // Classe simples para o C# entender o JSON das unidades
    public class UnidadeDto
    {
        public string ideProjeto { get; set; } = "";
        public string nomProjeto { get; set; } = "";
    }
}